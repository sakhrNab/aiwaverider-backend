# Stage 1: Build stage
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

COPY package*.json ./

# Install production dependencies only
RUN npm install --omit=dev

COPY . .

# Firebase credentials are injected via FIREBASE_SERVICE_ACCOUNT_JSON env var in production
# (no private key file needed in the image)

# Stage 2: Production stage
FROM node:20-alpine AS production

WORKDIR /usr/src/app

# Copy dependencies and built code from the builder stage
COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app ./

# Make entrypoint script executable
RUN chmod +x docker-entrypoint.sh

EXPOSE 5000

# Use entrypoint that auto-seeds on first run, then starts the app
ENTRYPOINT ["./docker-entrypoint.sh"]